# ─── Dev only ─────────────────────────────────────────────────────────────────
# Where the Vite dev proxy forwards `/api` and `/socket.io` so the SPA can share
# the same origin as the API (avoiding CORS + SameSite=None cookie hassles in dev).
# Example: http://localhost:3001 if you run the gateway/API locally on that port.
# When set, leave VITE_API_URL empty (the SPA will use relative URLs).
# Also required for the Cypress e2e suite's cy.fakeLogin() command (see
# cypress/support/commands.ts) to reach POST /api/login/fake — point this at
# whichever of the Gateway/API has ENABLE_FAKE_LOGIN=true.
VITE_DEV_PROXY_TARGET=
# Set to "true" to forward to a self-signed HTTPS dev target.
VITE_DEV_PROXY_INSECURE=false
