{
  "name": "play4cash-pwa",
  "private": true,
  "version": "1.0.63",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:azure": "npm run build && node scripts/prepare-azure-deploy.mjs",
    "start": "node server.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "version:bump:patch": "npm version patch --no-git-tag-version",
    "version:bump:minor": "npm version minor --no-git-tag-version",
    "version:bump:major": "npm version major --no-git-tag-version",
    "version:print": "node -p \"require('./package.json').version\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ionic/react": "^8.3.0",
    "@react-oauth/google": "^0.12.1",
    "axios": "^1.7.9",
    "ionicons": "^7.4.0",
    "jwt-decode": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.6",
    "workbox-window": "^7.3.0"
  }
}
